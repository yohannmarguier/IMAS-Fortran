prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: imas-fortran-@DD_VERSION@
Version: @PROJECT_VERSION@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Requires: al-core >= @AL_CORE_VERSION@
Cflags: -I${includedir}/fortran
Libs: -L${libdir} -lal-fortran-@DD_VERSION@ -Wl,--defsym,DD_VER_@DD_SAFE_VERSION@=0 -Wl,-rpath,${libdir}
