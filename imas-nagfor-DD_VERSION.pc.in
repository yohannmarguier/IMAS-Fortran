prefix=__PREFIX__
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: imas-nagfor-__DD_GIT_DESCRIBE__
Version: __UAL_GIT_DESCRIBE__
Description: IMAS Fortran Libraries (nagfor)
URL: https://imas.iter.org
Requires: imas-lowlevel = __UAL_GIT_DESCRIBE__
Cflags: -I${includedir}/nagfor
Libs: -L${libdir} -limas-nagfor-__DD_GIT_DESCRIBE__ -Wl,--defsym,UAL_VER___UAL_SAFE_DESCRIBE__=0 -Wl,--defsym,DD_VER___DD_SAFE_DESCRIBE__=0
