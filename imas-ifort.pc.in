prefix=__PREFIX__
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: imas-ifort
Description: IMAS Fortran Libraries (ifort)
URL: https://portal.iter.org/departments/POP/Pages/IM-Users-and-Developers.aspx
Version: __VERSION__
Libs: -L${libdir}/fortraninterface -lUALFORTRANInterface_ifort
Cflags: -I${includedir}/fortraninterface/amd64_ifort
