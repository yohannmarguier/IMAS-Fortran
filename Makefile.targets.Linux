sources_install: $(SOURCES) ids_schemas.f90 id_f90_sources_install
	$(INSTALL_DATA) $(SOURCES) ids_schemas.f90 $(datadir)/src/fortraninterface
sources_uninstall:
	-rm -rf $(datadir)/src/fortraninterface

fortran_install: $(IDSOBJECTS) libal-fortran.a_install libal-fortran.so_install | $(includedir)/fortran
	$(INSTALL_DATA) $(MODDIR)/*.mod $(includedir)/fortran

fortran_uninstall: libal-fortran.a_uninstall libal-fortran.so_uninstall
	-rm -f $(includedir)/fortran/*.mod


#--------------------- nagfor --------------
ifeq ("nagfor","$(strip $(FC))")
libal-fortran-$(DD_GIT_DESCRIBE).so.$(SO_NUM): $(LIBFILES_fortran)
	$(FC) $(FCFLAGS) -o $@ -Wl,-shared -Wl,-Wl,,$(SONAME_OPT),,$@ $^ $(LIBS)
else
#--------------------- g95 --------------
#--------------------- gfortran --------------
#--------------------- pgi --------------
#--------------------- ifort --------------
libal-fortran-$(DD_GIT_DESCRIBE).so.$(SO_NUM): $(LIBFILES_fortran)
	$(FC) $(FCFLAGS) -o $@ -shared -Wl,$(SONAME_OPT),$@ $^ $(LIBS)

endif

#--------------------- fortran --------------
libal-fortran-$(DD_GIT_DESCRIBE).so: %:%.$(SO_NUM)
	$(LN_S) $< $@
libal-fortran.so:libal-fortran-$(DD_GIT_DESCRIBE).so
	$(LN_S) $< $@
libal-fortran.so_install: %.so_install:%-$(DD_GIT_DESCRIBE).so.$(SO_NUM) | $(libdir)
	$(INSTALL_DATA) $< $(libdir)
	$(LN_S) $< $(libdir)/$*-$(DD_GIT_DESCRIBE).so
	$(LN_S) $< $(libdir)/$*.so

# Static library
libal-fortran-$(DD_GIT_DESCRIBE).a: $(LIBFILES_fortran)
	$(AR) rvs $@ $^
libal-fortran.a:libal-fortran-$(DD_GIT_DESCRIBE).a
	$(LN_S) $< $@
libal-fortran.a_install: %.a_install:%-$(DD_GIT_DESCRIBE).a | $(libdir)
	$(INSTALL_DATA) $< $(libdir)
	$(LN_S) $< $(libdir)/$*.a

libal-fortran.a_uninstall:
	-rm -f $(libdir)/$(@:%.a_uninstall=%).a
	-rm -f $(libdir)/$(@:%.a_uninstall=%)-$(DD_GIT_DESCRIBE).a
libal-fortran.so_uninstall:
	-rm -f $(libdir)/$(@:%.so_uninstall=%).so
	-rm -f $(libdir)/$(@:%.so_uninstall=%)-$(DD_GIT_DESCRIBE).so
	-rm -f $(libdir)/$(@:%.so_uninstall=%)-$(DD_GIT_DESCRIBE).so.$(SO_NUM)
