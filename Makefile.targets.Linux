sources_install: $(SOURCES) ids_schemas.f90 id_f90_sources_install
	$(INSTALL_DATA) $(SOURCES) ids_schemas.f90 $(datadir)/src/fortraninterface
sources_uninstall:
	-rm -rf $(datadir)/src/fortraninterface

pgi_install: $(IDSOBJECTS_pgi) libal-pgi.a_install libal-pgi.so_install | $(includedir)/pgi
	$(INSTALL_DATA) $(MODDIR_pgi)/*.mod $(includedir)/pgi
g95_install: $(IDSOBJECTS_g95) libal-g95.a_install libal-g95.so_install | $(includedir)/g95
	$(INSTALL_DATA) $(MODDIR_g95)/*.mod $(includedir)/g95
ifort_install: $(IDSOBJECTS_ifort) libal-ifort.a_install libal-ifort.so_install | $(includedir)/ifort
	$(INSTALL_DATA) $(MODDIR_ifort)/*.mod $(includedir)/ifort
nagfor_install: $(IDSOBJECTS_nagfor) libal-nagfor.a_install libal-nagfor.so_install | $(includedir)/nagfor
	$(INSTALL_DATA) $(MODDIR_nagfor)/*.mod $(includedir)/nagfor
gfortran_install: $(IDSOBJECTS_gfortran) libal-gfortran.a_install libal-gfortran.so_install | $(includedir)/gfortran
	$(INSTALL_DATA) $(MODDIR_gfortran)/*.mod $(includedir)/gfortran

pgi_uninstall: libal-pgi.a_uninstall libal-pgi.so_uninstall
	-rm -f $(includedir)/pgi/*.mod
g95_uninstall: libal-g95.a_uninstall libal-g95.so_uninstall
	-rm -f $(includedir)/g95/*.mod
ifort_uninstall: libal-ifort.a_uninstall libal-ifort.so_uninstall
	-rm -f $(includedir)/ifort/*.mod
nagfor_uninstall: libal-nagfor.a_uninstall libal-nagfor.so_uninstall
	-rm -f $(includedir)/nagfor/*.mod
gfortran_uninstall: libal-gfortran.a_uninstall libal-gfortran.so_uninstall
	-rm -f $(includedir)/gfortran/*.mod

#--------------------- g95 --------------
libal-g95-$(DD_GIT_DESCRIBE).so.$(SO_NUM): $(LIBFILES_g95)
	$(FC_g95) $(FCFLAGS_g95) -o $@ -shared -Wl,$(SONAME_OPT),$@ $^ $(LIBS)
libal-g95-$(DD_GIT_DESCRIBE).so: %:%.$(SO_NUM)
	$(LN_S) $< $@
libal-g95.so:libal-g95-$(DD_GIT_DESCRIBE).so
	$(LN_S) $< $@
libal-g95.so_install: %.so_install:%-$(DD_GIT_DESCRIBE).so.$(SO_NUM) | $(libdir)
	$(INSTALL_DATA) $< $(libdir)
	$(LN_S) $< $(libdir)/$*-$(DD_GIT_DESCRIBE).so
	$(LN_S) $< $(libdir)/$*.so

# Static library
libal-g95-$(DD_GIT_DESCRIBE).a: $(LIBFILES_g95)
	$(AR) rvs $@ $^
libal-g95.a:libal-g95-$(DD_GIT_DESCRIBE).a
	$(LN_S) $< $@
libal-g95.a_install: %.a_install:%-$(DD_GIT_DESCRIBE).a | $(libdir)
	$(INSTALL_DATA) $< $(libdir)
	$(LN_S) $< $(libdir)/$*.a

libal-g95.a_uninstall:
	-rm -f $(libdir)/$(@:%.a_uninstall=%).a
	-rm -f $(libdir)/$(@:%.a_uninstall=%)-$(DD_GIT_DESCRIBE).a
libal-g95.so_uninstall:
	-rm -f $(libdir)/$(@:%.so_uninstall=%).so
	-rm -f $(libdir)/$(@:%.so_uninstall=%)-$(DD_GIT_DESCRIBE).so
	-rm -f $(libdir)/$(@:%.so_uninstall=%)-$(DD_GIT_DESCRIBE).so.$(SO_NUM)

#--------------------- gfortran --------------
libal-gfortran-$(DD_GIT_DESCRIBE).so.$(SO_NUM): $(LIBFILES_gfortran)
	$(FC_gfortran) $(FCFLAGS_gfortran) -o $@ -shared -Wl,$(SONAME_OPT),$@ $^ $(LIBS)
