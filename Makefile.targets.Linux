#--------------------- nagfor --------------
libal-nagfor-$(DD_GIT_DESCRIBE).so.$(SO_NUM): $(LIBFILES_nagfor)
	$(FC_nagfor) $(FCFLAGS_nagfor) -o $@ -Wl,-shared -Wl,-Wl,,$(SONAME_OPT),,$@ $^ $(LIBS)
libal-nagfor-$(DD_GIT_DESCRIBE).so: %:%.$(SO_NUM)
