# You should have already installed imas and loaded it (IMAS_PREFIX variable) before running "make -f Makefile-ext check".

include ../../Makefile.common

ifeq (,$(ids_path))
$(error Please first install imas and then module load imas/... to populate environment)
endif

LIBS	= `pkg-config al-fortran --libs`

ifeq ("yes","$(strip $(IMAS_GFORTRAN))")
FC      = gfortran
FCFLAGS = -g -fdefault-real-8 -fPIC -fno-second-underscore -ffree-line-length-none `pkg-config al-fortran --cflags`
else ifeq ("yes","$(strip $(IMAS_IFORT))")
FC      = ifort
FCFLAGS = -r8 -assume no2underscore  -fPIC `pkg-config al-fortran --cflags` -shared-intel
else ifeq ("yes","$(strip $(IMAS_NVFORTRAN))")
FC      = nvfortran
FCFLAGS = -r8  -Mnosecond_underscore -fPIC `pkg-config al-fortran --cflags`
else ifeq ("yes","$(strip $(IMAS_NAGFOR))")
FC      = nagfor
FCFLAGS = -r8 -PIC `pkg-config al-fortran --cflags | sed 's/-Wl,/-Wl,-Wl,,/g'`
LIBS	= `pkg-config al-fortran --libs | sed 's/-Wl,/-Wl,-Wl,,/g'`
else ifeq ("yes","$(strip $(IMAS_G95))")
FC      =g95
FCFLAGS = -r8 -ftrace=full -fPIC -fno-second-underscore -ffree-line-length-huge `pkg-config al-fortran --cflags`
else
SOURCES_ONLY=yes
endif


# IDSDEF is set in environment, but if not, rely on IMAS_PREFIX
ifeq (,$(strip $(IDSDEF)))
IDSDEF = $(IMAS_PREFIX)/include/IDSDef.xml
endif

# Test environment is set already in env, but do write ids to tmp dir
TMPDIR = tmp
test_ENV = ids_path="$(abspath $(TMPDIR));$(ids_path)"

include Makefile.tests
