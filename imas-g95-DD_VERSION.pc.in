prefix=__PREFIX__
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: imas-g95-__DD_GIT_DESCRIBE__
Version: __UAL_GIT_DESCRIBE__
Description: IMAS Fortran Libraries (g95)
URL: https://imas.iter.org
Requires: imas-lowlevel = __UAL_GIT_DESCRIBE__
Cflags: -I${includedir}/g95
Libs: -L${libdir} -limas-g95-__DD_GIT_DESCRIBE__ -Wl,--defsym,AL_VER___AL_SAFE_DESCRIBE__=0 -Wl,--defsym,DD_VER___DD_SAFE_DESCRIBE__=0
