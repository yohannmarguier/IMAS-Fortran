program testindentifiers
    use ids_schemas, only: ids_equilibrium, &
        ids_distribution_sources
    use al_poloidal_plane_coordinates_identifier, &
        only: set_poloidal_plane_coordinates_identifier, &
        ppc_index => index, ppc_name => name, ppc_desc => description
    use al_distribution_source_identifier, & 
        only: set_distribution_source_identifier, &
        ds_index => index, ds_name => name, ds_desc => description
    
    implicit none
    integer :: i_nbi, i_inverse_psi_polar

    type(ids_equilibrium) :: equilibrium
    type(ids_distribution_sources) :: distribution_sources

    i_nbi = ds_index('NBI') 

    print *,ds_index('NBI')
    print *,ds_name(i_nbi)
    print *,ds_desc(i_nbi)

    i_inverse_psi_polar = ppc_index('inverse_psi_polar') 

    print *,ppc_index('inverse_psi_polar')
    print *,ppc_name(i_inverse_psi_polar)
    print *,ppc_desc(i_inverse_psi_polar)

    allocate( equilibrium%time_slice(1) )
    allocate( equilibrium%time_slice(1)%profiles_2d(1) )
    allocate(distribution_sources%source(1))
    allocate(distribution_sources%source(1)%process(1))

    call set_poloidal_plane_coordinates_identifier( equilibrium%time_slice(1)%profiles_2d(1)%grid_type, 'rectangular')

    print *,equilibrium%time_slice(1)%profiles_2d(1)%grid_type%name
    print *,equilibrium%time_slice(1)%profiles_2d(1)%grid_type%index
    print *,equilibrium%time_slice(1)%profiles_2d(1)%grid_type%description

    call set_distribution_source_identifier( distribution_sources%source(1)%process(1)%type, 'NBI')

    print *,distribution_sources%source(1)%process(1)%type%name
    print *,distribution_sources%source(1)%process(1)%type%index
    print *,distribution_sources%source(1)%process(1)%type%description

end program


