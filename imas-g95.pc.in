prefix=__PREFIX__
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: imas-g95
Version: __DD_GIT_DESCRIBE__-__UAL_GIT_DESCRIBE__
Description: IMAS Fortran Libraries (g95)
URL: https://imas.iter.org
Requires: imas-lowlevel = __DD_GIT_DESCRIBE__-__UAL_GIT_DESCRIBE__
Cflags: -I${includedir}/g95
Libs: -L${libdir} -limas-g95
