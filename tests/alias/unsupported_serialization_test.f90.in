! A second-version IDS intentionally has no serializer implementation. It must take
! ids_serialize's existing default branch, report that error, and return safely.
program unsupported_serialization_test
  use ids_routines, only: ids_serialize
  use ids_routines@SECOND_DD_MODULE_SUFFIX@, only: ids_@ALIAS_TEST_IDS@@SECOND_DD_MODULE_SUFFIX@
  implicit none

  type(ids_@ALIAS_TEST_IDS@@SECOND_DD_MODULE_SUFFIX@) :: ids
  character(len=1), allocatable :: buffer(:)

  call ids_serialize(ids, buffer)

  if (.not. allocated(buffer)) error stop 'unsupported serialization left buffer unallocated'
  if (size(buffer) /= 0) error stop 'unsupported serialization returned data'
end program unsupported_serialization_test
