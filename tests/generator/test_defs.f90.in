MODULE test_defs
    USE ids_utilities
    USE al_defs
    IMPLICIT NONE

    LOGICAL, PARAMETER :: debugMode = .FALSE.
    INTEGER :: dim1, dim2, dim3, dim4, dim5, dim6

    INTEGER, PARAMETER :: TEST_PULSE = 9998
    INTEGER, PARAMETER :: TEST_RUN = 9998
    
    ! All backends (/MEMORY_BACKEND, ASCII_BACKEND, MDSPLUS_BACKEND, HDF5_BACKEND, UDA_BACKEND/)
    INTEGER, dimension(${TEST_ARRAY_ALL_BACKENDS_LENGTH}), PARAMETER   :: ARRAY_ALL_BACKENDS = (/${TEST_ARRAY_ALL_BACKENDS}/)
    INTEGER, dimension(3), PARAMETER   :: ARRAY_ALL_TIME_MODES = (/IDS_TIME_MODE_HOMOGENEOUS, IDS_TIME_MODE_HETEROGENEOUS, IDS_TIME_MODE_INDEPENDENT/)
    
    INTEGER, PARAMETER   :: TEST_MODE_ALL    = 1
    INTEGER, PARAMETER   :: TEST_MODE_GLOBAL = 2
    INTEGER, PARAMETER   :: TEST_MODE_SLICE  = 3

    
    CHARACTER (LEN=*), PARAMETER ::PRINTABLE = '0123456789abcdef'
    !CHARACTER(LEN=*), PARAMETER :: PRINTABLE = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!\\"#$%&amp;\'()*+,-./:;&lt;=&gt;?@[\\]^_`{|}~\t\n\r"
    
    TYPE settings_type
        INTEGER, dimension(${TEST_ARRAY_ALL_BACKENDS_LENGTH}) :: backendIDArray = ARRAY_ALL_BACKENDS
        INTEGER, dimension(3) :: idsTimeModeArray = ARRAY_ALL_TIME_MODES
        INTEGER               :: testMode = TEST_MODE_ALL
        INTEGER               :: timeSize = 3  !number of slices to be tested
        INTEGER               :: dataSize = 3
        INTEGER               :: occToTest = 2
        LOGICAL :: useExistingPulseFile = .FALSE.
    END TYPE settings_type

    type (settings_type) :: config

END MODULE test_defs
