# You should have already installed imas and loaded it (IMAS_PREFIX variable) before running "make -f Makefile-ext check".
# Until the testSuite is made modular (one test program per IDS), it is recommended to avoid running the IFORT case (huge source file, takes ages to compile)
# To detect if an error has been reported, search for "ERROR:" strings in the result file (fortraninterface/tests/generator/gfortran_testSuite.results)

include ../../../Makefile.common

ifeq (,$(ids_path))
$(error Please first install imas and then module load imas/... to populate environment)
endif

#------------------------------- gfortran ----------------------------------
FC_gfortran=gfortran
COPTS_gfortran = -g -fdefault-real-8 -fPIC -fno-second-underscore -ffree-line-length-none `pkg-config al-gfortran --cflags`
LIBS_gfortran = `pkg-config al-gfortran al-lowlevel --libs` -lm

#------------------------------- ifort ----------------------------------
FC_ifort=ifort
COPTS_ifort = -g -r8 -assume no2underscore  -fPIC `pkg-config al-ifort --cflags` -shared-intel
LIBS_ifort= `pkg-config al-ifort al-lowlevel --libs` -lm

IDSDEF = $(IMAS_PREFIX)/include/IDSDef.xml

include Makefile.tests
