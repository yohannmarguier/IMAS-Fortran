END FUNCTION getComplex3DArray

FUNCTION getComplex4DArray(inSizeOfArray) RESULT (outArray)
    INTEGER, INTENT(in), OPTIONAL ::inSizeOfArray
    INTEGER  ::sizeOfArray
!    COMPLEX,DIMENSION(sizeOfArray):: outArray
    COMPLEX(2*EUITM_R8),DIMENSION(:,:,:,:),POINTER :: outArray
    INTEGER::I
    
       sizeOfArray = DIM_SIZE**4
     
    ALLOCATE(outArray(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE))
    
    outArray =  RESHAPE(getComplexArray(sizeOfArray), (/DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE/))   
   
