       END SUBROUTINE assertField_DBL4DArray
        
         SUBROUTINE assertField_DBL5DArray(observed, expected, fieldName)
       IMPLICIT NONE
              REAL(EUITM_R8), DIMENSION(:,:,:, :,:), POINTER, INTENT (IN)      :: observed, expected
