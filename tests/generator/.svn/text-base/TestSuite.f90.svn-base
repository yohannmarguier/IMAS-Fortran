    COMPLEX(2*EUITM_R8),DIMENSION(:,:),ALLOCATABLE :: outArray
    
    sizeOfArray = DIM_SIZE**2
     
    ALLOCATE(outArray(DIM_SIZE, DIM_SIZE))
 
    outArray =  RESHAPE(getComplexArray(sizeOfArray), (/DIM_SIZE, DIM_SIZE/))   
   
