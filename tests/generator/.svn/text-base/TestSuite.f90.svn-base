FUNCTION getComplex1DArray(inSizeOfArray) RESULT (outArray)
    INTEGER, INTENT(in), OPTIONAL ::inSizeOfArray
    INTEGER  ::sizeOfArray
    COMPLEX(2*EUITM_R8),DIMENSION(:),POINTER :: outArray
    
     sizeOfArray = DIM_SIZE**1
     
     ALLOCATE(outArray(DIM_SIZE))
     outArray =  RESHAPE(getComplexArray(sizeOfArray), (/DIM_SIZE/))      
   
    RETURN
END FUNCTION getComplex1DArray


FUNCTION getComplex2DArray(inSizeOfArray) RESULT (outArray)
    INTEGER, INTENT(in), OPTIONAL ::inSizeOfArray
