	end if
	
       END SUBROUTINE assertField_DBL5DArray
        
         SUBROUTINE assertField_DBL6DArray(observed, expected, fieldName)
       IMPLICIT NONE
              REAL(EUITM_R8), DIMENSION(:,:,:, :,:,:), POINTER, INTENT (IN)      :: observed, expected
       CHARACTER*(*),INTENT(IN) :: fieldName
	
	IF(.not. associated(observed)) then
		write(*,*) fieldName, " : ERROR, field is not associated!!!"
		return
	END IF
	
	IF(ALL(observed.EQ.expected)) then

	write(*,*) fieldName, " : OK "
	  
	  else
