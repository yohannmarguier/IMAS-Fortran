<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:fn="http://www.w3.org/2005/xpath-functions">
    <xsl:output method="text"/>
    <xsl:strip-space elements="*"/>

    <!-- Initial code -->
    <xsl:template match="CPOs">
    	
	 <!-- ================================ MAIN PROGRAM ================================= -->
        <xsl:text>PROGRAM test&#10;</xsl:text>
	<xsl:text>&#9;use comparator &#10;</xsl:text>
	<xsl:text>&#9;use euITM_schemas &#10;</xsl:text>
	<xsl:text>&#9;!use euITM_ual_defs &#10;</xsl:text>

	<xsl:text>&#9;use testSuite&#10;</xsl:text>
        <xsl:text>&#9;implicit none&#10;</xsl:text>



    <xsl:text>&#9;INTEGER :: idx;&#10;</xsl:text>
        <xsl:text>&#10;</xsl:text>
	

	<!-- READ args
	
	integer::narg,cptArg !#of arg & counter of arg character(len=20)::name !Arg name !Check if any arguments are found narg=command_argument_count()!Loop over the arguments if(narg>0)then!loop across options do cptArg=1,narg
	  call get_command_argument(cptArg,name)   select case(adjustl(name))    case("-help","-h")     write(*,*)"This is program TestArg : Version 0.1"    case default     write(*,*)"Option ",adjustl(name),"unknown"   end select end do end ifend program TestArg
        PROGRAM test_getarg INTEGER :: i CHARACTER(len=32) :: arg DO i = 1, iargc() CALL getarg(i, arg) WRITE (*,*) arg END DO END PROGRAMRead more: http://www.physicsforums.com
	-->
        <xsl:text>&#9;call init(idx);&#10;</xsl:text>
        <xsl:apply-templates select="child::CPO" mode="test"/>
        <xsl:text>&#9;call finish();&#10;</xsl:text>
	
    <xsl:text>CONTAINS&#10;</xsl:text>
	
<!--        <xsl:call-template name="getArrayGenerator"/> -->
<!--
        <xsl:apply-templates select="child::CPO[@type='waves']" mode="put"/>
        <xsl:apply-templates select="child::CPO[@type='waves']" mode="get"/> 

-->
           <xsl:apply-templates select="child::CPO" mode="put"/>
        <xsl:apply-templates select="child::CPO" mode="get"/> 
	
        <xsl:text>END PROGRAM test&#10;</xsl:text>
        <xsl:text>&#10;</xsl:text>
	<!-- ================================ MAIN PROGRAM (end)================================= -->
    </xsl:template>

 <!-- ============================= END OF GENRATED FILE ============================== -->

 <!-- ============================= TEMPLATES ============================== -->

        <!--Documentation for a single field-->
    <xsl:template name = "COMMENT_FIELD">
        <xsl:text>&#xA;</xsl:text>
	<xsl:text>&#9;&#9;!!!  </xsl:text><xsl:value-of select="@name"/>:<xsl:value-of select="@path"/>:<xsl:value-of select="@data_type"/>:<xsl:value-of select="@type"/>:<xsl:text>&#xA;</xsl:text>
   
    </xsl:template>

    <xsl:template name="getArrayGenerator">
        <xsl:text>&#9;private static Object getArray(Types t, int length) {&#10;</xsl:text>
        <xsl:text>&#9;&#9;switch (t) {&#10;</xsl:text>
        <xsl:text>&#9;&#9;case DOUBLE:&#10;</xsl:text>
        <xsl:call-template name="generateArray">
            <xsl:with-param name="type" select="'double'"/>
        </xsl:call-template>

        <xsl:text>&#9;&#9;case COMPLEX:&#10;</xsl:text>
        <xsl:call-template name="generateArray">
            <xsl:with-param name="type" select="'UALComplexNumber'"/>
        </xsl:call-template>
   
    <xsl:text>&#9;&#9;case INTEGER:&#10;</xsl:text>
        <xsl:call-template name="generateArray">
            <xsl:with-param name="type" select="'int'"/>
        </xsl:call-template>
        <xsl:text>&#9;&#9;case STRING:&#10;</xsl:text>
        <xsl:call-template name="generateArray">
            <xsl:with-param name="type" select="'String'"/>
        </xsl:call-template>
        <xsl:text>&#9;&#9;default:&#10;</xsl:text>
        <xsl:text>&#9;&#9;&#9;return null;&#10;</xsl:text>
        <xsl:text>&#9;&#9;}&#10;</xsl:text>
        <xsl:text>&#9;}&#10;</xsl:text>
        <xsl:text>&#10;</xsl:text>
    </xsl:template>


    <xsl:template name="generateArray">
        <xsl:param name="type"/>
  	       <xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$type"/><xsl:text>[] array</xsl:text><xsl:value-of select="$type"/><xsl:text> = new </xsl:text><xsl:value-of select="$type"/><xsl:text>[length];&#10;</xsl:text>
               <xsl:text>&#9;&#9;&#9;while (--length >= 0)&#10;</xsl:text>
               <xsl:text>&#9;&#9;&#9;&#9;array</xsl:text><xsl:value-of select="$type"/><xsl:text>[length] = get</xsl:text><xsl:value-of select="$type"/><xsl:text>();&#10;</xsl:text>
               <xsl:text>&#9;&#9;&#9;return array</xsl:text><xsl:value-of select="$type"/><xsl:text>;&#10;</xsl:text>        
    </xsl:template>


    <!-- CPO perform the tests -->
 <xsl:template match="CPO" mode="test"> 
<!-- <xsl:template match="CPO[@type='waves']" mode="test"> -->
        <xsl:text>&#10;</xsl:text>
        <xsl:text>&#9;! --- CPO: </xsl:text><xsl:value-of select="@type"/><xsl:text> ---&#10;</xsl:text>
       <xsl:text>&#9;call </xsl:text><xsl:value-of select="@type"/><xsl:text>_put()&#10;</xsl:text>
       <xsl:text>&#9;call </xsl:text><xsl:value-of select="@type"/><xsl:text>_get()&#10;</xsl:text> 
    </xsl:template>

    
    <!-- CPO put()-->
    <xsl:template match="CPO" mode="put">
        <xsl:text>!==================================================================&#10;</xsl:text>
       <xsl:text>!&#9;&#9; PUT </xsl:text><xsl:value-of select="@type"/> <xsl:text> &#10;</xsl:text>
       <xsl:text>!==================================================================&#10;</xsl:text>
	<xsl:text>SUBROUTINE </xsl:text><xsl:value-of select="@type"/><xsl:text>_put&#10;</xsl:text>
	<xsl:text>&#9;CHARACTER (:), parameter :: cpoName = "</xsl:text><xsl:value-of select="@type"/><xsl:text>"&#10;</xsl:text>
	<xsl:text>&#9;TYPE (type_</xsl:text><xsl:value-of select="@type"/><xsl:text>) :: cpo &#10;</xsl:text>
	<xsl:text>&#9;CHARACTER (LEN=20) :: cpopath &#10;</xsl:text>
	<xsl:text>&#9;CHARACTER (LEN=2) :: occurence = "" &#10;</xsl:text>
	<xsl:text>&#9;INTEGER :: i &#10;</xsl:text>
	<xsl:text>&#9;INTEGER :: tmpInt = -1 &#10;</xsl:text>
        <xsl:text>&#9;WRITE(*,*) "Testing put() on </xsl:text><xsl:value-of select="@type"/><xsl:text>"&#10;</xsl:text>
        <xsl:text>&#9;CALL srand(seed)&#10;</xsl:text>
        <xsl:text>&#9;do i = 0, </xsl:text><xsl:value-of select="@maxoccur"/><xsl:text> &#10;</xsl:text>
         <xsl:apply-templates select="field" mode="put"/> 
	<xsl:text>&#9;&#9;!------------&#10;</xsl:text>
	<xsl:text>&#9;&#9;if (i == 0) then &#10;</xsl:text>
	<xsl:text>&#9;&#9;&#9;cpopath = cpoName  &#10;</xsl:text>
	<xsl:text>&#9;&#9;else&#10;</xsl:text>
	<xsl:text>&#9;&#9;&#9;WRITE( occurence, '(i2)' )  i &#10;</xsl:text>
        <xsl:text>&#9;&#9;&#9;cpopath = cpoName//'/'//ADJUSTL(occurence)&#10;</xsl:text>
	<xsl:text>&#9;&#9;end if &#10;</xsl:text>
	<xsl:text>  &#10;</xsl:text>
	
        <xsl:choose>
            <xsl:when test="@timed='no'">
	        <xsl:text>&#9;&#9;call euitm_put(idx, cpopath, cpo);&#10;</xsl:text>
	    </xsl:when>
            <xsl:otherwise>
                <xsl:text>&#9;&#9;call euitm_put_non_timed(idx ,cpopath, cpo);&#10;</xsl:text>
		<xsl:text>&#9;&#9;call euitm_put_slice(idx ,cpopath, cpo);&#10;</xsl:text>
            </xsl:otherwise>
        </xsl:choose>
	 <!-- <xsl:text>&#9;call euitm_deallocate(cpo)&#10;</xsl:text> -->
	  <xsl:text>&#9;end do &#10;</xsl:text>
        <xsl:text>&#10;</xsl:text>
        <xsl:text>END SUBROUTINE </xsl:text> <xsl:value-of select="@type"/><xsl:text>_put &#10;</xsl:text>
        <xsl:text>&#10;</xsl:text>
    </xsl:template>


    <!-- CPO get()-->
    <xsl:template match="CPO" mode="get">
       <xsl:text>!==================================================================&#10;</xsl:text>
       <xsl:text>!&#9;&#9; GET </xsl:text><xsl:value-of select="@type"/> <xsl:text> &#10;</xsl:text>
       <xsl:text>!==================================================================&#10;</xsl:text>
	<xsl:text>SUBROUTINE </xsl:text><xsl:value-of select="@type"/><xsl:text>_get&#10;</xsl:text>
	<xsl:text>&#9;CHARACTER (:), parameter :: cpoName = "</xsl:text><xsl:value-of select="@type"/><xsl:text>"&#10;</xsl:text>
	<xsl:text>&#9;TYPE (type_</xsl:text><xsl:value-of select="@type"/><xsl:text>) :: cpo &#10;</xsl:text>
	<xsl:text>&#9;CHARACTER (LEN=20) :: cpopath &#10;</xsl:text>
	<xsl:text>&#9;CHARACTER (LEN=2) :: occurence = "" &#10;</xsl:text>
	<xsl:text>&#9;INTEGER :: i &#10;</xsl:text>
        <xsl:text>&#9;WRITE(*,*) "Testing get() on </xsl:text><xsl:value-of select="@type"/><xsl:text>"&#10;</xsl:text>
        <xsl:text>&#9;CALL srand(seed)&#10;</xsl:text>
        <xsl:text>&#9;do i = 0, </xsl:text><xsl:value-of select="@maxoccur"/><xsl:text> &#10;</xsl:text>

<xsl:text>&#9;&#9;!------------&#10;</xsl:text>
	<xsl:text>&#9;&#9;if (i == 0) then &#10;</xsl:text>
	<xsl:text>&#9;&#9;&#9;cpopath = cpoName  &#10;</xsl:text>
	<xsl:text>&#9;&#9;else&#10;</xsl:text>
	<xsl:text>&#9;&#9;&#9;WRITE( occurence, '(i2)' )  i &#10;</xsl:text>
        <xsl:text>&#9;&#9;&#9;cpopath = cpoName//'/'//ADJUSTL(occurence)&#10;</xsl:text>
	<xsl:text>&#9;&#9;end if &#10;</xsl:text>
	<xsl:text>  &#10;</xsl:text>
  	
        <xsl:choose>
            <xsl:when test="@timed='no'">
	        <xsl:text>&#9;&#9;call euitm_get(idx, cpopath, cpo);&#10;</xsl:text>
	    </xsl:when>
            <xsl:otherwise>
		<xsl:text>&#9;&#9;call euitm_get_slice(idx ,cpopath, cpo, 1.0, 1);&#10;</xsl:text>
            </xsl:otherwise>
        </xsl:choose>

        <xsl:apply-templates select="field" mode="get"/>
		 <!-- <xsl:text>&#9;call euitm_deallocate(cpo)&#10;</xsl:text> -->
	  <xsl:text>&#9;end do &#10;</xsl:text>
        <xsl:text>&#9;&#10;</xsl:text>
        <xsl:text>END SUBROUTINE </xsl:text><xsl:value-of select="@type"/><xsl:text>_get&#10;</xsl:text>
	<xsl:text>&#10;</xsl:text>
    </xsl:template>


    <!-- field put() -->  
    <xsl:template match="field[not(@type='structure' or @type='struct_array')]" mode="put">
      <!--  <xsl:text>&#9;&#9;&#9;cpo%</xsl:text><xsl:value-of select="translate(@path, '/', '%')"/><xsl:text> = </xsl:text><xsl:call-template name="type2value"/><xsl:text>&#10;</xsl:text> -->
	  <xsl:variable name="CPO_FIELD_PATH">  <xsl:text>&#9;&#9;cpo%</xsl:text><xsl:value-of select="translate(@path, '/', '%')"/></xsl:variable> 
	<xsl:text>&#10;&#9;&#9;!!!</xsl:text><xsl:value-of select="@name"/> : <xsl:value-of select="@path"/> : <xsl:value-of select="@type"/><xsl:text>&#10;</xsl:text>
            <xsl:call-template name="setValue">
                <xsl:with-param name="fieldPath" select="concat('cpo%',translate(@path, '/', '%'))"/>
            </xsl:call-template>
    </xsl:template>




  <!-- field put() -->  
    <xsl:template match="field[ @type='struct_array']" mode="put">
      <!--  <xsl:text>&#9;&#9;&#9;cpo%</xsl:text><xsl:value-of select="translate(@path, '/', '%')"/><xsl:text> = </xsl:text><xsl:call-template name="type2value"/><xsl:text>&#10;</xsl:text> -->
	  <xsl:variable name="CPO_FIELD_PATH">  <xsl:text>&#9;&#9;cpo%</xsl:text><xsl:value-of select="translate(@path, '/', '%')"/><xsl:text> = </xsl:text> </xsl:variable> 
	<xsl:text>&#10;&#9;&#9;!!!</xsl:text><xsl:value-of select="@name"/> : <xsl:value-of select="@path"/> : <xsl:value-of select="@type"/><xsl:text>&#10;</xsl:text>

        <xsl:call-template name="putStructArray">
            <xsl:with-param name="path" select="concat(translate(@path, '/', '%'), '(1)')"/>
            <xsl:with-param name="resize" select="true()"/>
        </xsl:call-template>

    </xsl:template>


    <xsl:template name="putStructArray">
        <xsl:param name="path"/>
        <xsl:param name="resize"/>
        <xsl:if test="$resize">
		<xsl:text>&#9;&#9;&#9;allocate(cpo%</xsl:text><xsl:value-of select="substring($path, 1, string-length($path) - 3)"/><xsl:text> (1))&#10; </xsl:text>
		<!--
		<xsl:text>&#9;&#9;&#9;cpo%</xsl:text><xsl:value-of select="substring($path, 1, string-length($path) - 3)"/><xsl:text> = new UALAccess.</xsl:text><xsl:value-of select="ancestor::CPO/@type"/><xsl:for-each select="ancestor-or-self::field"><xsl:text>%</xsl:text><xsl:value-of select="@name"/><xsl:if test="@type='struct_array' or @type='structure'">BlaXXX</xsl:if></xsl:for-each><xsl:text>(1);&#10;</xsl:text>
		<xsl:text>&#9;&#9;&#9;cpo.</xsl:text><xsl:value-of select="substring($path, 1, string-length($path) - 3)"/><xsl:text>(1) = new UALAccess.</xsl:text><xsl:value-of select="ancestor::CPO/@type"/><xsl:for-each select="ancestor-or-self::field"><xsl:text>.</xsl:text><xsl:value-of select="@name"/><xsl:if test="@type='struct_array' or @type='structure'">Class</xsl:if></xsl:for-each><xsl:text>();&#10;</xsl:text> -->
	</xsl:if> 
        <xsl:for-each select="field[not(@type='struct_array' or @type='structure')]">
            <!-- <xsl:text>&#9;&#9;&#9;cpo%</xsl:text><xsl:value-of select="concat($path, '%', @name)"/><xsl:text> = </xsl:text><xsl:call-template name="type2value"/>;<xsl:text>&#10;</xsl:text> --> 
	            <xsl:call-template name="setValue">
                <xsl:with-param name="fieldPath" select="concat('cpo%', $path, '%', @name)"/>
            </xsl:call-template>
        </xsl:for-each>
        <xsl:for-each select="field[@type='structure']">
            <xsl:call-template name="putStructArray">
                <xsl:with-param name="path" select="concat($path, '%', @name)"/>
                <xsl:with-param name="resize" select="false()"/>
            </xsl:call-template>
        </xsl:for-each>
        <xsl:for-each select="field[@type='struct_array']">
            <xsl:call-template name="putStructArray">
                <xsl:with-param name="path" select="concat($path, '%', @name, '(1)')"/>
                <xsl:with-param name="resize" select="true()"/>
            </xsl:call-template>
        </xsl:for-each>
    </xsl:template> 


    <!-- field get() -->


    <xsl:template match="field[not(@type='structure' or @type='struct_array')]" mode="get">
    	<xsl:call-template name="COMMENT_FIELD"/>      
        <xsl:text>&#9;&#9;&#9; call assertField(cpo%</xsl:text><xsl:value-of select="translate(@path, '/', '%')"/><xsl:text>, </xsl:text><xsl:call-template name="type2value"/><xsl:text>, "</xsl:text><xsl:value-of select="ancestor::CPO/@type"/><xsl:text>/</xsl:text><xsl:value-of select="@path"/><xsl:text>");&#10;</xsl:text>
    </xsl:template>

    <!-- field get() for array of structures -->

    <xsl:template match="field[@type='struct_array']" mode="get">
        	<xsl:call-template name="COMMENT_FIELD"/> 
			
	<xsl:text>&#9;&#9;if(.not. associated(cpo%</xsl:text>  <xsl:value-of select="translate(@path, '/', '%')" /> <xsl:text>)) then &#10;</xsl:text>
		<xsl:text>&#9;&#9;&#9;write(*,*) "ERROR! CPO: </xsl:text> <xsl:value-of select="ancestor::CPO/@type"/> <xsl:text> Field: </xsl:text> <xsl:value-of select="translate(@path, '/', '%')" /> <xsl:text> is not associated!"&#10; </xsl:text>
			<!-- <xsl:text>&#9;&#9;&#9;return &#10;</xsl:text> -->
					<xsl:text>&#9;&#9;&#9;else &#10;</xsl:text>  

        <xsl:call-template name="getStructArray">
            <xsl:with-param name="path" select="concat(translate(@path, '/', '%'), '(1)')"/>
        </xsl:call-template>
		<xsl:text>&#9;&#9;end if &#10;</xsl:text> 
    </xsl:template>

    <xsl:template name="getStructArray">
        <xsl:param name="path"/>
        <xsl:for-each select="field[not(@type='struct_array' or @type='structure')]">
	
        	<xsl:call-template name="COMMENT_FIELD"/>
            <xsl:text>&#9;&#9;&#9;call assertField(cpo%</xsl:text><xsl:value-of select="concat($path, '%', @name)"/><xsl:text>, </xsl:text><xsl:call-template name="type2value"/><xsl:text>, "</xsl:text><xsl:value-of select="ancestor::CPO/@type"/><xsl:text>/</xsl:text><xsl:value-of select="@path"/><xsl:text>");&#10;</xsl:text>
        </xsl:for-each>
        <xsl:for-each select="field[@type='structure']">
	<xsl:call-template name="COMMENT_FIELD"/>
            <xsl:call-template name="getStructArray">
                <xsl:with-param name="path" select="concat($path, '%', @name)"/>
            </xsl:call-template>
        </xsl:for-each>
        <xsl:for-each select="field[@type='struct_array']">
	<xsl:call-template name="COMMENT_FIELD"/>
	
	<xsl:text>&#9;&#9;if(.not. associated(cpo%</xsl:text>  <xsl:value-of select="concat($path, '%', @name)" /> <xsl:text>)) then &#10;</xsl:text>
		<xsl:text>&#9;&#9;&#9;write(*,*) "ERROR! CPO: </xsl:text>  <xsl:value-of select="ancestor::CPO/@type"/> <xsl:text> Field: </xsl:text><xsl:value-of select="concat($path, '%', @name, '(1)')" /> <xsl:text> is not associated!"&#10; </xsl:text>
		<!-- <xsl:text>&#9;&#9;&#9;return &#10;</xsl:text>  -->
			<xsl:text>&#9;&#9;&#9;else &#10;</xsl:text>  
	
	     <xsl:call-template name="getStructArray">
                <xsl:with-param name="path" select="concat($path, '%', @name, '(1)')"/>
            </xsl:call-template>
	<xsl:text>&#9;&#9;end if &#10;</xsl:text> 
        </xsl:for-each>
    </xsl:template> 


    <xsl:template name="setValue">
            <xsl:param name="fieldPath"/>
	     
        <xsl:choose>
            <xsl:when test="@name='time'">          
	    		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/> <xsl:text>= getTime()&#10;</xsl:text>
	    </xsl:when>

            <xsl:when test="@type='xs:string'"> 
	        	     	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(1)) &#10;</xsl:text>        
	    		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/> <xsl:text> = getString()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='vecstring_type'">	
	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE)) &#10;</xsl:text>
	    <xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/>     <xsl:text> = getString1DArray()&#10;</xsl:text>
	    </xsl:when>

            <xsl:when test="@type='xs:float'">           	
	   	<xsl:text>&#9;&#9;&#9;</xsl:text>  <xsl:value-of select="$fieldPath"/> <xsl:text> = getDouble()&#10;</xsl:text>
	    </xsl:when>
	    
	
            <xsl:when test="@type='vecflt_type'"> 
	    	     	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE)) &#10;</xsl:text>
	             	<xsl:text>&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getDouble1DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='matflt_type'">      
	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE)) &#10;</xsl:text>
	       		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getDouble2DArray()&#10;</xsl:text>
	</xsl:when>
      
	    <xsl:when test="@type='array3dflt_type'">    
	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text> 
	    		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getDouble3DArray()&#10;</xsl:text>
		</xsl:when>
            <xsl:when test="@type='array4dflt_type'">     	
	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text> 
	    	<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getDouble4DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array5dflt_type'">    
	    	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text> 
	    		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/> <xsl:text> = getDouble5DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array6dflt_type'">     
	    	    	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text> 
	    		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getDouble6DArray()&#10;</xsl:text>
	    </xsl:when>

            <xsl:when test="@type='xs:integer'">    
	     		<xsl:text>&#9;&#9;&#9;tmpInt = getInteger()&#10;</xsl:text>
	           		<!-- <xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/> <xsl:text>= getInteger()&#10;</xsl:text> -->
			 <xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/> <xsl:text>= tmpInt&#10;</xsl:text>
	     		<xsl:text>&#9;&#9;&#9;write(*,*) "</xsl:text><xsl:value-of select="$fieldPath"/> <xsl:text>", tmpInt&#10;</xsl:text> 
	    </xsl:when>
	
            <xsl:when test="@type='vecint_type'">       
	        	     	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE)) &#10;</xsl:text>
	      		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getInteger1DArray()&#10;</xsl:text>
	    </xsl:when>
      
	    <xsl:when test="@type='matint_type'">         
	    <xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE)) &#10;</xsl:text>
	    		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getInteger2DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array3dint_type'">
	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text>      
	    		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getInteger3DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array4dint_type'">   
	    	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text>   
	    		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getInteger4DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array5dint_type'">    
	    	    	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text> 
	     		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getInteger5DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array6dint_type'"> 
	    	    	    	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text>    
	     		<xsl:text>&#9;&#9;&#9;</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text> = getInteger6DArray()&#10;</xsl:text>
	    </xsl:when>

          
	  
	  
	  
	  
	  
            <xsl:when test="@type='cplx_type'">   
	        	<xsl:value-of select="$fieldPath"/> <xsl:text> = getComplex()&#10;</xsl:text>
	  </xsl:when>
            <xsl:when test="@type='veccplx_type'">   
	        	     	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE)) &#10;</xsl:text>
	     	<xsl:value-of select="$fieldPath"/><xsl:text> = getComplex1DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='matcplx_type'">   
	    <xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE)) &#10;</xsl:text>
	     	<xsl:value-of select="$fieldPath"/><xsl:text> = getComplex2DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array3dcplx_type'">    
	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text> 
	    	<xsl:value-of select="$fieldPath"/><xsl:text> = getComplex3DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array4dcplx_type'">   
	    	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text> 
	     	<xsl:value-of select="$fieldPath"/><xsl:text> = getComplex4DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array5dcplx_type'">    
	    	    	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text> 
	    	<xsl:value-of select="$fieldPath"/><xsl:text> = getComplex5DArray()&#10;</xsl:text>
	    </xsl:when>
            <xsl:when test="@type='array6dcplx_type'">   
	    	    	    	    	    	    	<xsl:text>&#9;&#9;allocate(</xsl:text><xsl:value-of select="$fieldPath"/><xsl:text>(DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE, DIM_SIZE)) &#10;</xsl:text> 
	    	<xsl:value-of select="$fieldPath"/> <xsl:text> = getComplex6DArray()&#10;</xsl:text>
	    </xsl:when>
   

            <xsl:otherwise><xsl:text>&#9;&#9;!ERROR1 ERROR!&#10;</xsl:text></xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="type2value">
        <xsl:choose>
            <xsl:when test="@name='time'">              <xsl:text>getTime()</xsl:text></xsl:when>

            <xsl:when test="@type='xs:string'">         <xsl:text>getString()</xsl:text></xsl:when>
            <xsl:when test="@type='vecstring_type'">    <xsl:text> getStringArray(1)</xsl:text></xsl:when>

            <xsl:when test="@type='xs:float'">          <xsl:text>getDouble()</xsl:text></xsl:when>
            <xsl:when test="@type='vecflt_type'">       <xsl:text>getDouble1DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='matflt_type'">       <xsl:text>getDouble2DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array3dflt_type'">   <xsl:text>getDouble3DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array4dflt_type'">   <xsl:text>getDouble4DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array5dflt_type'">   <xsl:text>getDouble5DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array6dflt_type'">   <xsl:text>getDouble6DArray()</xsl:text></xsl:when>

            <xsl:when test="@type='xs:integer'">        <xsl:text>getInteger()</xsl:text></xsl:when>
            <xsl:when test="@type='vecint_type'">       <xsl:text>getInteger1DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='matint_type'">       <xsl:text>getInteger2DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array3dint_type'">   <xsl:text>getInteger3DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array4dint_type'">   <xsl:text>getInteger4DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array5dint_type'">   <xsl:text>getInteger5DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array6dint_type'">   <xsl:text>getInteger6DArray()</xsl:text></xsl:when>

          
            <xsl:when test="@type='cplx_type'">      <xsl:text>getComplex()</xsl:text></xsl:when>
            <xsl:when test="@type='veccplx_type'">  <xsl:text> getComplex1DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='matcplx_type'">  <xsl:text>getComplex2DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array3dcplx_type'">  <xsl:text>getComplex3DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array4dcplx_type'">  <xsl:text>getComplex4DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array5dcplx_type'">  <xsl:text> getComplex5DArray()</xsl:text></xsl:when>
            <xsl:when test="@type='array6dcplx_type'">  <xsl:text>getComplex6DArray()</xsl:text></xsl:when>
   

            <xsl:otherwise><xsl:text>null</xsl:text></xsl:otherwise>
        </xsl:choose>
    </xsl:template>
</xsl:stylesheet>
