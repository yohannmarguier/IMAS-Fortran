		!!!tria_upper :  : structure

		!!!tev :  : structure

		!!!tiv :  : structure

		!!!nev :  : structure

		!!!zeffv :  : structure

		!!!beta_pol :  : structure

		!!!beta_tor :  : structure

		!!!beta_normal :  : structure

		!!!li :  : structure

		!!!volume :  : structure

		!!!area :  : structure

		!!!main_ion1_z :  : structure

		!!!main_ion1_a :  : structure

		!!!main_ion2_z :  : structure

		!!!main_ion2_a :  : structure

		!!!impur1_z :  : structure

		!!!impur1_a :  : structure

		!!!time : time : xs:float
		cpo%time =  getTime()
		!------------
		if (i > 0) then 
			WRITE( occurence, '(i2)' )  i 
			cpopath = cpopath//"\"//occurence
		end if 
  
		cpopath = TRIM(ADJUSTL(cpopath)) 
		call euitm_put(idx, cpopath, cpo);
	end do 

END SUBROUTINE summary_put 

