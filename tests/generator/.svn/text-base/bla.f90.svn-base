	do i = 0, 1 + 1

		!!!datainfo :  : structure

		!!!setup :  : structure

		!!!measure :  : structure

		!!!time : time : xs:float
		cpo%time =  getTime()
		!------------
		if (i > 0) then 
			WRITE( occurence, '(i2)' )  i 
			cpopath = cpopath//"\"//occurence
		end if 
  
		cpopath = TRIM(ADJUSTL(cpopath)) 
		call euitm_put_non_timed(idx ,cpopath, cpo);
		call euitm_put_slice(idx ,cpopath, cpo);
	end do 

END SUBROUTINE tsdiag_put 

