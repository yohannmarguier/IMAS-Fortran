	WRITE(*,*) "Testing put() on amns"
	CALL srand(seed)
	do i = 0, 20 + 1

		!!!datainfo :  : structure

		!!!version : version : xs:string

		!!!source : source : xs:string

		!!!zn : zn : xs:integer
