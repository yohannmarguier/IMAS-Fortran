PROGRAM test
	use euITM_schemas 
	!use euITM_ual_defs 
	use testSuite
	implicit none
	INTEGER :: idx = -1;

	call init(idx);

	! --- CPO: topinfo ---
	call topinfo_put()

	! --- CPO: summary ---
	call summary_put()

	! --- CPO: amns ---
	call amns_put()

	! --- CPO: antennas ---
	call antennas_put()

	! --- CPO: compositionc ---
	call compositionc_put()

	! --- CPO: coredelta ---
	call coredelta_put()

	! --- CPO: coreneutrals ---
	call coreneutrals_put()

	! --- CPO: coreimpur ---
	call coreimpur_put()

	! --- CPO: coreprof ---
	call coreprof_put()

	! --- CPO: coresource ---
	call coresource_put()

	! --- CPO: coretransp ---
	call coretransp_put()

	! --- CPO: cxdiag ---
	call cxdiag_put()

	! --- CPO: distribution ---
	call distribution_put()

	! --- CPO: distsource ---
	call distsource_put()

	! --- CPO: ecediag ---
	call ecediag_put()

	! --- CPO: edge ---
	call edge_put()

	! --- CPO: efcc ---
	call efcc_put()

	! --- CPO: equilibrium ---
	call equilibrium_put()

	! --- CPO: fusiondiag ---
	call fusiondiag_put()

	! --- CPO: halphadiag ---
	call halphadiag_put()

	! --- CPO: interfdiag ---
	call interfdiag_put()

	! --- CPO: ironmodel ---
	call ironmodel_put()

	! --- CPO: langmuirdiag ---
	call langmuirdiag_put()

	! --- CPO: launchs ---
	call launchs_put()

	! --- CPO: limiter ---
	call limiter_put()

	! --- CPO: lithiumdiag ---
	call lithiumdiag_put()

	! --- CPO: mhd ---
	call mhd_put()

	! --- CPO: magdiag ---
	call magdiag_put()

	! --- CPO: msediag ---
	call msediag_put()

	! --- CPO: nbi ---
	call nbi_put()

	! --- CPO: neoclassic ---
	call neoclassic_put()

	! --- CPO: orbit ---
	call orbit_put()

	! --- CPO: pellets ---
	call pellets_put()

	! --- CPO: pfsystems ---
	call pfsystems_put()

	! --- CPO: polardiag ---
	call polardiag_put()

	! --- CPO: reference ---
	call reference_put()

	! --- CPO: reflectomet ---
	call reflectomet_put()

	! --- CPO: rfadiag ---
	call rfadiag_put()

	! --- CPO: sawteeth ---
	call sawteeth_put()

	! --- CPO: scenario ---
	call scenario_put()

	! --- CPO: toroidfield ---
	call toroidfield_put()

	! --- CPO: tsdiag ---
	call tsdiag_put()

	! --- CPO: turbulence ---
	call turbulence_put()

	! --- CPO: vessel ---
	call vessel_put()

	! --- CPO: wall ---
	call wall_put()

	! --- CPO: waves ---
	call waves_put()
	call finish();
CONTAINS
!==================================================================
!		 PUT topinfo 
!==================================================================
SUBROUTINE topinfo_put
	TYPE (type_topinfo) :: cpo 
	CHARACTER (LEN=20) :: cpopath = "topinfo"
	CHARACTER (LEN=2) :: occurence = "" 
	INTEGER :: i 
	WRITE(*,*) "Testing put() on topinfo"
	CALL srand(seed)
	do i = 0, 1 + 1

		!!!dataprovider : dataprovider : xs:string

		!!!description : description : xs:string

		!!!firstputdate : firstputdate : xs:string

		!!!lastupdate : lastupdate : xs:string

		!!!source : source : xs:string

		!!!comment : comment : xs:string

		!!!dataversion : dataversion : xs:string

		!!!workflow : workflow : xs:string

		!!!entry :  : structure

		!!!parent_entry :  : structure

		!!!mdinfo :  : structure
		!------------
		if (i > 0) then 
			WRITE( occurence, '(i2)' )  i 
			cpopath = cpopath//"\"//occurence
		end if 
  
		cpopath = TRIM(ADJUSTL(cpopath)) 
		call euitm_put(idx, cpopath, cpo);
	end do 

END SUBROUTINE topinfo_put 

!==================================================================
!		 PUT summary 
!==================================================================
SUBROUTINE summary_put
	TYPE (type_summary) :: cpo 
	CHARACTER (LEN=20) :: cpopath = "summary"
	CHARACTER (LEN=2) :: occurence = "" 
	INTEGER :: i 
	WRITE(*,*) "Testing put() on summary"
	CALL srand(seed)
	do i = 0, 1 + 1

		!!!datainfo :  : structure

		!!!ip :  : structure

		!!!bvac_r :  : structure

		!!!geom_axis_r :  : structure

		!!!a_minor :  : structure

