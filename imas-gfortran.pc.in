prefix=__PREFIX__
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: imas-gfortran
Version: __DD_GIT_DESCRIBE__-__UAL_GIT_DESCRIBE__
Description: IMAS Fortran Libraries (gfortran)
URL: https://imas.iter.org
Requires.private: imas-lowlevel = __DD_GIT_DESCRIBE__-__UAL_GIT_DESCRIBE__
Cflags: -I${includedir}/gfortran
Libs: -L${libdir} -limas-gfortran
